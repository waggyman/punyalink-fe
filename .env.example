# API (punyalink-api)
VITE_API_URL=http://localhost:3000

# Production base domain for subdomain parsing
VITE_BASE_DOMAIN=punyalink.id

# Comma-separated hosts treated as apex (no tenant)
VITE_APEX_HOSTS=punyalink.id,www.punyalink.id,localhost,127.0.0.1

# On localhost, simulate a store tenant (e.g. acme.punyalink.id)
VITE_DEV_TENANT=acme
